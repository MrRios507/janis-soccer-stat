@startuml Use Cases Overview
left to right direction

actor "Data Engineer" as engineer
actor "Operator" as operator
actor "Analyst" as analyst
actor "Modeler" as modeler

rectangle "janis-soccer-stat" {
    ' Increment 1. Traces to FR-001, FR-011, FR-012; FR-013 arrives with increment 2
    usecase "UC-001\nLoad Historical Match Data" as UC001 #LightGreen
    ' Increment 3. Traces to FR-002
    usecase "UC-002\nCollect Match Shots" as UC002
    ' Increment 4. Traces to FR-003
    usecase "UC-003\nCollect Team Statistics" as UC003
    ' Increment 4. Traces to FR-004
    usecase "UC-004\nCollect Lineups" as UC004
    ' Increment 1. Traces to FR-009, FR-010; FR-008 arrives with increment 3
    usecase "UC-005\nResolve Team Identity" as UC005 #LightGreen
    ' Increment 1. Traces to FR-006, FR-007
    usecase "UC-006\nReprocess Retained Documents" as UC006 #LightGreen
    ' Increment 1. Traces to FR-005, FR-022
    usecase "UC-007\nMonitor Collection Run" as UC007 #LightGreen
    ' Increment 4. Traces to FR-023, FR-024
    usecase "UC-008\nReport Data Coverage" as UC008
    ' Increment 5. Traces to FR-014, FR-015, FR-016
    usecase "UC-009\nCompute Match Features" as UC009
    ' Increment 5. Traces to FR-017, FR-018
    usecase "UC-010\nTrain Prediction Model" as UC010
    ' Increment 5. Traces to FR-020, FR-021
    usecase "UC-011\nEvaluate Model Against Market" as UC011
    ' Increment 5. Traces to FR-019
    usecase "UC-012\nPredict Scheduled Match" as UC012
    ' Increment 5. Traces to FR-025
    usecase "UC-013\nDerive Player Absences" as UC013
    ' Increment 1. Traces to FR-010
    usecase "UC-014\nResolve Held Record" as UC014 #LightGreen
    ' Increment 1. Traces to FR-026, FR-027; FR-028 arrives with increment 4
    usecase "UC-015\nConfigure Collection Scope" as UC015 #LightGreen
}

engineer --> UC001
engineer --> UC002
engineer --> UC003
engineer --> UC004
engineer --> UC005
engineer --> UC006
engineer --> UC014
engineer --> UC015

operator --> UC007

analyst --> UC008
analyst --> UC012

modeler --> UC009
modeler --> UC010
modeler --> UC011
modeler --> UC013

UC001 ..> UC005 : <<include>>
UC002 ..> UC005 : <<include>>
UC003 ..> UC005 : <<include>>
UC004 ..> UC005 : <<include>>

note bottom of UC005
  Collection use cases must resolve
  the publishing source's team name
  to a known team before storing data.
end note

note bottom of UC014
  UC-001 to UC-005 hold whatever they
  cannot bind confidently. UC-014 is
  where a person clears that queue.
  In increment 1 the only kind of value
  held is a team name.
end note

note bottom of UC015
  UC-015 establishes the preconditions
  every collection use case assumes:
  the competition, the seasons and the
  source must be known before UC-001
  to UC-004 can run at all.
end note

legend bottom
  Highlighted: increment 1, Match History.
  Later increments: UC-002 in 3; UC-003, UC-004 and UC-008 in 4;
  UC-009 to UC-013 in 5. Their specifications are held at status
  Deferred until their increment opens. See docs/vision.md.
end legend

@enduml
